FLASK_SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=true

ADMIN_EMAIL=replace-with-admin-email
ADMIN_PASSWORD=replace-with-admin-password
DATABASE_PATH=sidewalk_demo.db

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
AWS_SESSION_TOKEN=
AWS_IOT_ENDPOINT=replace-with-iot-endpoint
AWS_IOT_UPLINK_TOPIC=replace-with-uplink-topic
AWS_IOT_LOCATION_TOPIC=replace-with-location-topic
SIDEWALK_DESTINATION_NAME=
SIDEWALK_LOCATION_DESTINATION_NAME=
SIDEWALK_DEVICE_PROFILE_ID=
SIDEWALK_WIRELESS_DEVICE_ID=replace-with-wireless-device-id
SIDEWALK_DOWNLINK_ACK_RETRY_SECS=10

MQTT_CLIENT_ID=sidewalk-web-demo
EVENT_BACKLOG_SIZE=64

# BLE NUS manufacturing-page provisioning
SIDEWALK_PROVISIONING_MAX_FRAGMENT_BYTES=64

# Memfault gateway. Leave MEMFAULT_ENABLED unset/false to keep the feature off;
# every value below is safe to leave unset.
MEMFAULT_ENABLED=false
MEMFAULT_PROJECT_KEY=
MEMFAULT_ORG_SLUG=
MEMFAULT_PROJECT_SLUG=
MEMFAULT_ORG_AUTH_TOKEN=
MEMFAULT_CHUNKS_BASE_URL=https://chunks.memfault.com
MEMFAULT_API_BASE_URL=https://api.memfault.com
MEMFAULT_DEVICE_SERIAL_SOURCE=smsn
MEMFAULT_HTTP_TIMEOUT_SECS=10
MEMFAULT_CHUNK_MAX_ATTEMPTS=8
MEMFAULT_CHUNK_MAX_BACKOFF_SECS=300
MEMFAULT_WORKER_POLL_SECS=5

